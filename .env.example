# Django Settings
DJANGO_SECRET_KEY="dev-galli-smartkottu-django-secret-change-in-prod"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# APP_URL: Public frontend URL (used in generated Store QR links)
APP_URL="http://localhost:3000"

# Frontend Configuration (Vite)
VITE_APP_NAME="Galli Smartkottu"
VITE_API_BASE_URL="/api/v1"
VITE_BACKEND_URL="http://127.0.0.1:8000"

# Auth & Webhook Secrets
JWT_SECRET="dev-galli-smartkottu-jwt-secret-change-in-prod"
N8N_WEBHOOK_SECRET="dev-n8n-hmac-secret-change-in-prod"

# Supabase PostgreSQL Connection
# Copy the exact URI from Supabase Dashboard -> Connect -> Transaction pooler (port 6543) or Session pooler (port 5432).
# Note: URL-encode special characters in your password (e.g., '@' -> '%40').
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Optional Supabase API credentials (if integrating Supabase Storage / Auth / Realtime later)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

